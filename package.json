{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate:hero-images": "node scripts/generate-hero-images.mjs",
    "generate:seo": "node scripts/generate-seo.mjs",
    "seo:validate": "node scripts/validate-seo.mjs",
    "seo:validate:dist": "node scripts/validate-seo.mjs --dist",
    "predev": "npm run generate:hero-images",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run generate:hero-images && npm run generate:seo",
    "build": "vite build",
    "postbuild": "npm run seo:validate:dist",
    "preview": "vite preview",
    "format": "oxfmt",
    "i18n:check": "node --experimental-strip-types scripts/check-translations.mjs"
  },
  "dependencies": {
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
